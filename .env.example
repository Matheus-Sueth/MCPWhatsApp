# Valores reais ficam SOMENTE no .env local ou em secrets da VPS.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_DATABASE_PATH=data/whatsapp.sqlite3

# Bloqueia envio por padrão. Liste explicitamente os contatos autorizados.
MCP_ENABLE_SEND=false
MCP_ALLOWED_RECIPIENTS=
MCP_APPROVAL_TTL_SECONDS=600

# local: APENAS para desenvolvimento na própria máquina, sem proxy/túnel.
# oauth: OBRIGATÓRIO para exposição remota ao ChatGPT.
MCP_AUTH_MODE=local
MCP_BIND_HOST=127.0.0.1
MCP_PORT=8000
MCP_PUBLIC_HOST=
MCP_ALLOWED_ORIGINS=

# Obrigatórias no modo oauth (JWT RS256 assinado por provedor confiável).
OAUTH_ISSUER_URL=
OAUTH_JWKS_URL=
OAUTH_AUDIENCE=
OAUTH_RESOURCE_URL=
OAUTH_ALLOWED_SUBJECTS=
